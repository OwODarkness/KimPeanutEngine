/asset/

# The depth-only directional-shadow program is engine source, not imported
# content. Keep the rest of the generated/imported asset tree ignored.
!/asset/
/asset/*
!/asset/shader/
/asset/shader/*
!/asset/shader/directional_shadow_depth.shader
!/asset/shader/tone_map.shader
!/asset/shader/tone_map.frag
!/asset/shader/deferred_lighting.shader
!/asset/shader/deferred_lighting.frag
!/asset/shader/pbr_gbuffer.vert
!/asset/shader/pbr_gbuffer.frag
!/asset/shader/pbr_gbuffer.shader
!/asset/shader/gbuffer_debug_view.vert
!/asset/shader/gbuffer_debug_view.frag
!/asset/shader/gbuffer_debug_view.shader
!/asset/level/
!/asset/level/*.level
!/asset/shader/capture_view.frag
!/asset/shader/capture_view.shader
!/asset/shader/directionalshadow_mapping_depth.vert
!/asset/shader/directionalshadow_mapping_depth.frag
!/asset/material/
/asset/material/*
!/asset/material/error.material

