#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_control_flow_attributes : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT top_level;
layout(set = 0, binding = 1, rgba16f) uniform image2D output_image;
layout(set = 0, binding = 35, rgba16f) readonly uniform image2D history_image;
layout(set = 0, binding = 36, rgba16f) writeonly uniform image2D guide_image;
layout(set = 0, binding = 4) uniform sampler2D environment_texture;

struct HitPayload
{
    vec3 position;
    uint hit;
    vec3 normal;
    vec3 albedo;
    vec3 emissive;
    float metallic;
    float roughness;
    vec3 radiance;
    float cone_width;
    float cone_spread;
};

struct LightData
{
    vec4 position_or_type;
    vec4 direction_and_range;
    vec4 color_intensity;
    vec4 parameters;
};

struct GeometryData
{
    uvec4 address_words;
    uvec4 attributes;
};

struct InstanceData
{
    uvec4 geometry_material_count;
};

struct MaterialData
{
    vec4 base_color;
    vec4 emissive;
    vec4 surface;
    uvec4 texture_indices;
};

layout(set = 0, binding = 2, std140) uniform CameraData
{
    mat4 inverse_view_projection;
    vec4 camera_position;
    vec4 light_center;
    vec4 light_u;
    vec4 light_v;
    vec4 light_radiance;
    uint rng_seed;
    uint sample_count;
    uint samples_per_dispatch;
    uint probe_mode;
    uvec4 scene_data;
} camera;

layout(set = 0, binding = 3, std140) uniform SceneData
{
    GeometryData geometries[512];
    InstanceData instances[512];
    MaterialData materials[512];
    LightData lights[128];
} scene;

layout(location = 0) rayPayloadEXT HitPayload payload;
layout(location = 1) rayPayloadEXT uint visibility_payload;

uint Hash(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

float Luminance(vec3 color)
{
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

float Random(uint stream, uint sample_index)
{
    const uint path_sample_index = camera.sample_count + sample_index;
    const uint seed = gl_LaunchIDEXT.x * 0x9e3779b9u ^
                      gl_LaunchIDEXT.y * 0x85ebca6bu ^
                      camera.rng_seed * 0xc2b2ae35u ^
                      path_sample_index * 0x165667b1u ^
                      stream * 0x27d4eb2fu;
    return float(Hash(seed) >> 8u) * (1.0 / 16777216.0);
}

HitPayload Trace(vec3 origin, vec3 direction, float t_max,
                 float cone_width, float cone_spread)
{
    payload.hit = 0u;
    payload.radiance = vec3(0.0);
    payload.cone_width = cone_width;
    payload.cone_spread = cone_spread;
    traceRayEXT(top_level, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
                origin, 0.001, direction, t_max, 0);
    return payload;
}

bool TraceVisibility(vec3 origin, vec3 direction, float t_max)
{
    if ((camera.probe_mode & (1u << 8u)) != 0u)
    {
        rayQueryEXT query;
        rayQueryInitializeEXT(query, top_level,
                              gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                              0xff, origin, 0.001, direction, t_max);
        while (rayQueryProceedEXT(query))
        {
        }
        return rayQueryGetIntersectionTypeEXT(query, true) !=
               gl_RayQueryCommittedIntersectionNoneEXT;
    }

    visibility_payload = 1u;
    traceRayEXT(top_level,
                gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT |
                    gl_RayFlagsSkipClosestHitShaderEXT,
                0xff, 0, 0, 1, origin, 0.001, direction, t_max, 1);
    return visibility_payload != 0u;
}

vec3 EvaluateBrdf(HitPayload surface, vec3 normal, vec3 view_direction,
                  vec3 light_direction)
{
    const float n_dot_l = max(dot(normal, light_direction), 0.0);
    const float n_dot_v = max(dot(normal, view_direction), 0.0);
    if (n_dot_l <= 0.0 || n_dot_v <= 0.0)
        return vec3(0.0);

    const float metallic = surface.metallic;
    const float roughness = surface.roughness;
    const vec3 f0 = mix(vec3(0.04), surface.albedo, metallic);
    const vec3 half_vector = normalize(view_direction + light_direction);
    const float n_dot_h = max(dot(normal, half_vector), 0.0);
    const float v_dot_h = max(dot(view_direction, half_vector), 0.0);
    const float alpha = roughness * roughness;
    const float alpha2 = alpha * alpha;
    const float denominator = n_dot_h * n_dot_h * (alpha2 - 1.0) + 1.0;
    const float distribution = alpha2 / max(3.14159265 * denominator * denominator, 1e-12);
    const float geometry_v = 2.0 * n_dot_v /
        (n_dot_v + sqrt(alpha2 + (1.0 - alpha2) * n_dot_v * n_dot_v));
    const float geometry_l = 2.0 * n_dot_l /
        (n_dot_l + sqrt(alpha2 + (1.0 - alpha2) * n_dot_l * n_dot_l));
    const vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - v_dot_h, 5.0);
    const vec3 specular = distribution * geometry_v * geometry_l * fresnel /
                          max(4.0 * n_dot_v * n_dot_l, 1e-8);
    const vec3 diffuse = (1.0 - fresnel) * (1.0 - metallic) *
                         surface.albedo / 3.14159265;
    return diffuse + specular;
}

vec3 DirectLight(HitPayload surface, vec3 view_direction)
{
    vec3 result = vec3(0.0);
    const vec3 normal = normalize(surface.normal);
    [[dont_unroll]] for (uint index = 0u; index < camera.scene_data.w; ++index)
    {
        const LightData light = scene.lights[index];
        vec3 light_direction;
        vec3 incident = light.color_intensity.rgb * light.color_intensity.a;
        float maximum_distance = 100000.0;
        const uint type = uint(light.position_or_type.w + 0.5);
        if (type == 0u)
        {
            light_direction = normalize(-light.direction_and_range.xyz);
        }
        else
        {
            const vec3 to_light = light.position_or_type.xyz - surface.position;
            const float distance_squared = dot(to_light, to_light);
            const float distance_to_light = sqrt(distance_squared);
            if (distance_to_light <= 1e-4 ||
                distance_to_light >= light.direction_and_range.w)
                continue;
            light_direction = to_light / distance_to_light;
            maximum_distance = distance_to_light - 0.002;
            const float range_weight = clamp(
                1.0 - pow(distance_to_light / light.direction_and_range.w, 4.0), 0.0, 1.0);
            incident *= range_weight * range_weight / max(distance_squared, 1e-3);
            if (type == 2u)
            {
                const float spot_cosine = dot(-light_direction,
                                              normalize(light.direction_and_range.xyz));
                const float cone = smoothstep(light.parameters.y, light.parameters.x,
                                              spot_cosine);
                if (cone <= 0.0)
                    continue;
                incident *= cone;
            }
        }
        const float cosine = max(dot(normal, light_direction), 0.0);
        if (cosine <= 0.0)
            continue;
        if (light.parameters.z > 0.5)
        {
            if (TraceVisibility(surface.position + normal * 0.002,
                                light_direction, maximum_distance))
                continue;
        }
        result += incident * EvaluateBrdf(surface, normal, view_direction,
                                          light_direction) * cosine;
    }
    return result;
}

vec3 CosineDirection(vec3 normal, uint sample_index, uint bounce_index)
{
    const vec2 random = vec2(Random(32u + bounce_index * 2u, sample_index),
                             Random(33u + bounce_index * 2u, sample_index));
    const float phi = 6.2831853 * random.x;
    const float cos_theta = sqrt(1.0 - random.y);
    const float sin_theta = sqrt(random.y);
    const vec3 tangent = normalize(abs(normal.y) < 0.999
                                   ? cross(normal, vec3(0.0, 1.0, 0.0))
                                   : cross(normal, vec3(1.0, 0.0, 0.0)));
    return normalize(tangent * (cos(phi) * sin_theta) +
                     cross(normal, tangent) * (sin(phi) * sin_theta) +
                     normal * cos_theta);
}

bool SampleBsdf(HitPayload surface, vec3 view_direction, uint sample_index,
                uint bounce, out vec3 direction, out vec3 weight)
{
    const vec3 normal = normalize(surface.normal);
    const vec3 f0 = mix(vec3(0.04), surface.albedo, surface.metallic);
    const float specular_probability = surface.metallic >= 0.999
        ? 1.0 : clamp(max(max(f0.r, f0.g), f0.b), 0.1, 0.9);
    if (Random(128u + bounce * 3u, sample_index) < specular_probability)
    {
        const vec2 xi = vec2(Random(129u + bounce * 3u, sample_index),
                             Random(130u + bounce * 3u, sample_index));
        const float alpha = surface.roughness * surface.roughness;
        const float cos_theta = sqrt((1.0 - xi.y) /
                                     (1.0 + (alpha * alpha - 1.0) * xi.y));
        const float sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
        const float phi = 6.2831853 * xi.x;
        const vec3 tangent = normalize(abs(normal.y) < 0.999
            ? cross(normal, vec3(0.0, 1.0, 0.0)) : cross(normal, vec3(1.0, 0.0, 0.0)));
        const vec3 half_vector = normalize(tangent * (cos(phi) * sin_theta) +
            cross(normal, tangent) * (sin(phi) * sin_theta) + normal * cos_theta);
        direction = reflect(-view_direction, half_vector);
    }
    else
        direction = CosineDirection(normal, sample_index, bounce);

    const float cosine = dot(normal, direction);
    if (cosine <= 0.0)
        return false;
    const vec3 half_vector = normalize(view_direction + direction);
    const float n_dot_h = max(dot(normal, half_vector), 0.0);
    const float v_dot_h = max(dot(view_direction, half_vector), 0.0);
    const float alpha = surface.roughness * surface.roughness;
    const float denominator = n_dot_h * n_dot_h * (alpha * alpha - 1.0) + 1.0;
    const float distribution = alpha * alpha /
        max(3.14159265 * denominator * denominator, 1e-12);
    const float specular_pdf = distribution * n_dot_h / max(4.0 * v_dot_h, 1e-8);
    const float pdf = specular_probability * specular_pdf +
        (1.0 - specular_probability) * cosine / 3.14159265;
    if (pdf <= 0.0)
        return false;
    // The full mixture PDF keeps either sampled lobe consistent with direct shading.
    weight = EvaluateBrdf(surface, normal, view_direction, direction) * cosine / pdf;
    return !any(isnan(weight)) && !any(isinf(weight));
}

HitPayload TracePrimary()
{
    const vec2 uv = (vec2(gl_LaunchIDEXT.xy) + vec2(0.5)) /
                    vec2(gl_LaunchSizeEXT.xy);
    vec4 far_point = camera.inverse_view_projection * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    far_point /= far_point.w;
    const vec3 origin = camera.camera_position.xyz;
    const vec3 direction = normalize(far_point.xyz - origin);
    vec2 x_uv = (vec2(gl_LaunchIDEXT.xy) + vec2(1.5, 0.5)) /
                vec2(gl_LaunchSizeEXT.xy);
    vec2 y_uv = (vec2(gl_LaunchIDEXT.xy) + vec2(0.5, 1.5)) /
                vec2(gl_LaunchSizeEXT.xy);
    vec4 x_point = camera.inverse_view_projection * vec4(x_uv * 2.0 - 1.0, 1.0, 1.0);
    vec4 y_point = camera.inverse_view_projection * vec4(y_uv * 2.0 - 1.0, 1.0, 1.0);
    x_point /= x_point.w;
    y_point /= y_point.w;
    const float cone_spread = max(length(normalize(x_point.xyz - origin) - direction),
                                  length(normalize(y_point.xyz - origin) - direction));
    return Trace(origin, direction, 1000.0, 0.0, cone_spread);
}

vec3 TraceContinuation(HitPayload primary, uint sample_index,
                       vec3 primary_contribution)
{
    if (primary.hit == 0u)
        return primary.radiance;

    vec3 radiance = primary_contribution;
    vec3 throughput = vec3(1.0);
    HitPayload surface = primary;
    vec3 view_direction = normalize(camera.camera_position.xyz - primary.position);
    const uint maximum_bounces = uint(clamp(camera.light_center.w, 0.0, 32.0));
    [[dont_unroll]] for (uint bounce = 0u; bounce < maximum_bounces; ++bounce)
    {
        vec3 bounce_direction;
        vec3 weight;
        if (!SampleBsdf(surface, view_direction, sample_index, bounce, bounce_direction, weight))
            break;
        throughput *= weight;
        if (bounce >= 3u)
        {
            const float survival = clamp(max(max(throughput.r, throughput.g), throughput.b), 0.05, 0.95);
            if (Random(192u + bounce, sample_index) >= survival)
                break;
            throughput /= survival;
        }
        const float next_cone_spread = min(surface.cone_spread +
            max(surface.roughness, 0.04) * 0.5, 1.0);
        const HitPayload next_surface = Trace(surface.position + surface.normal * 0.002,
                                              bounce_direction, 1000.0,
                                              surface.cone_width, next_cone_spread);
        if (next_surface.hit == 0u)
        {
            radiance += throughput * next_surface.radiance;
            break;
        }
        view_direction = -bounce_direction;
        surface = next_surface;
        radiance += throughput * (surface.emissive + DirectLight(surface, view_direction));
    }
    return radiance;
}

void main()
{
    const ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    const uint output_probe = camera.probe_mode & 0xffu;
    const HitPayload primary = TracePrimary();
    imageStore(guide_image, pixel,
               vec4(primary.hit != 0u ? normalize(primary.normal) : vec3(0.0),
                    primary.hit != 0u
                        ? length(camera.camera_position.xyz - primary.position)
                        : -1.0));
    vec3 radiance_sum = vec3(0.0);
    float luminance_squared_sum = 0.0;
    if (output_probe == 1u)
    {
        radiance_sum = (primary.hit != 0u ? vec3(1.0) : vec3(0.0)) *
                       float(camera.samples_per_dispatch);
    }
    else if (output_probe == 2u)
    {
        const vec3 normal = primary.hit != 0u ? primary.normal * 0.5 + 0.5 : vec3(0.0);
        radiance_sum = normal * float(camera.samples_per_dispatch);
    }
    else if (output_probe == 3u)
    {
        const vec3 albedo = primary.hit != 0u ? primary.albedo : primary.radiance;
        radiance_sum = albedo * float(camera.samples_per_dispatch);
    }
    else if (output_probe == 5u)
    {
        const vec3 surface = primary.hit != 0u
            ? vec3(primary.metallic, primary.roughness, 0.0) : vec3(0.0);
        radiance_sum = surface * float(camera.samples_per_dispatch);
    }
    else if (primary.hit == 0u)
    {
        radiance_sum = primary.radiance * float(camera.samples_per_dispatch);
        const float luminance = Luminance(primary.radiance);
        luminance_squared_sum = luminance * luminance *
                                float(camera.samples_per_dispatch);
    }
    else
    {
        const vec3 view_direction = normalize(camera.camera_position.xyz - primary.position);
        const vec3 primary_contribution = primary.emissive + DirectLight(primary, view_direction);
        if (output_probe == 4u)
        {
            radiance_sum = primary_contribution * float(camera.samples_per_dispatch);
            const float luminance = Luminance(primary_contribution);
            luminance_squared_sum = luminance * luminance *
                                    float(camera.samples_per_dispatch);
        }
        else
        {
            [[dont_unroll]] for (uint sample_index = 0u;
                                sample_index < camera.samples_per_dispatch; ++sample_index)
            {
                const vec3 sample_radiance = TraceContinuation(
                    primary, sample_index, primary_contribution);
                const float luminance = Luminance(sample_radiance);
                radiance_sum += sample_radiance;
                luminance_squared_sum += luminance * luminance;
            }
        }
    }

    const float batch_sample_count = float(camera.samples_per_dispatch);
    const vec3 batch_mean = radiance_sum / batch_sample_count;
    const float batch_mean_luminance = Luminance(batch_mean);
    const float batch_m2 = max(luminance_squared_sum - batch_sample_count *
                               batch_mean_luminance * batch_mean_luminance, 0.0);
    const uint next_sample_count = camera.sample_count + camera.samples_per_dispatch;
    float accumulated_variance = batch_m2 / max(batch_sample_count - 1.0, 1.0);
    if (camera.sample_count > 0u)
    {
        const vec4 previous = imageLoad(history_image, pixel);
        const float previous_sample_count = float(camera.sample_count);
        const float next_count = float(next_sample_count);
        const float previous_mean_luminance = Luminance(previous.rgb);
        const float delta = batch_mean_luminance - previous_mean_luminance;
        radiance_sum = (previous.rgb * previous_sample_count + radiance_sum) / next_count;
        const float previous_m2 = previous.a * max(previous_sample_count - 1.0, 0.0);
        const float combined_m2 = previous_m2 + batch_m2 + delta * delta *
            previous_sample_count * batch_sample_count / next_count;
        accumulated_variance = combined_m2 / max(next_count - 1.0, 1.0);
    }
    else
        radiance_sum = batch_mean;
    imageStore(output_image, pixel, vec4(radiance_sum, accumulated_variance));
}
