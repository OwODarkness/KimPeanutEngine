#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT top_level;
layout(set = 0, binding = 1, rgba16f) uniform image2D output_image;
layout(set = 0, binding = 35, rgba16f) readonly uniform image2D history_image;

layout(set = 0, binding = 2, std140) uniform CameraData
{
    mat4 inverse_view_projection;
    vec4 camera_position;
    vec4 light_center;
    vec4 light_u;
    vec4 light_v;
    vec4 light_radiance;
    uint rng_seed;
    uint sample_count;
    uint samples_per_dispatch;
    uint probe_mode;
    uvec2 padding;
    uvec4 geometry_index_starts[4];
} camera;

struct HitPayload
{
    vec3 position;
    uint hit;
    vec3 normal;
    uint geometry;
    vec3 albedo;
};

layout(location = 0) rayPayloadEXT HitPayload payload;

uint Hash(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

float Random(uint stream, uint sample_index)
{
    const uint path_sample_index = camera.sample_count + sample_index;
    const uint seed = gl_LaunchIDEXT.x * 0x9e3779b9u ^
                      gl_LaunchIDEXT.y * 0x85ebca6bu ^
                      camera.rng_seed * 0xc2b2ae35u ^
                      path_sample_index * 0x165667b1u ^
                      stream * 0x27d4eb2fu;
    return float(Hash(seed) >> 8u) * (1.0 / 16777216.0);
}

HitPayload Trace(vec3 origin, vec3 direction, float t_max)
{
    payload.hit = 0u;
    traceRayEXT(top_level, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
                origin, 0.001, direction, t_max, 0);
    return payload;
}

vec3 DirectLight(HitPayload surface, uint bounce, uint sample_index)
{
    const vec3 light_normal = normalize(cross(camera.light_u.xyz, camera.light_v.xyz));
    const float light_area = 4.0 * length(cross(camera.light_u.xyz, camera.light_v.xyz));
    vec3 sum = vec3(0.0);
    for (uint light_sample_index = 0u; light_sample_index < 4u; ++light_sample_index)
    {
        const uint stream = bounce * 8u + light_sample_index * 2u;
        const vec2 square = vec2(Random(stream, sample_index),
                                 Random(stream + 1u, sample_index)) *
                            2.0 - 1.0;
        const vec3 light_position = camera.light_center.xyz +
                                    camera.light_u.xyz * square.x +
                                    camera.light_v.xyz * square.y;
        const vec3 to_light = light_position - surface.position;
        const float distance_squared = dot(to_light, to_light);
        const float distance_to_light = sqrt(distance_squared);
        const vec3 direction = to_light / max(distance_to_light, 1e-4);
        const float cos_surface = max(dot(surface.normal, direction), 0.0);
        const float cos_light = max(dot(light_normal, -direction), 0.0);
        if (cos_surface <= 0.0 || cos_light <= 0.0 || distance_to_light <= 0.004)
            continue;
        const HitPayload blocker = Trace(surface.position + surface.normal * 0.002,
                                         direction, distance_to_light - 0.004);
        if (blocker.hit == 0u)
            sum += surface.albedo * camera.light_radiance.rgb *
                   (cos_surface * cos_light * light_area /
                    (3.14159265 * max(distance_squared, 1e-4)));
    }
    return sum * 0.25;
}

vec3 CosineDirection(vec3 normal, uint sample_index)
{
    const vec2 random = vec2(Random(32u, sample_index), Random(33u, sample_index));
    const float phi = 6.2831853 * random.x;
    const float cos_theta = sqrt(1.0 - random.y);
    const float sin_theta = sqrt(random.y);
    const vec3 tangent = normalize(abs(normal.y) < 0.999
                                   ? cross(normal, vec3(0.0, 1.0, 0.0))
                                   : cross(normal, vec3(1.0, 0.0, 0.0)));
    return normalize(tangent * (cos(phi) * sin_theta) +
                     cross(normal, tangent) * (sin(phi) * sin_theta) +
                     normal * cos_theta);
}

vec3 TraceSample(uint sample_index)
{
    const vec2 uv = (vec2(gl_LaunchIDEXT.xy) + vec2(0.5)) /
                    vec2(gl_LaunchSizeEXT.xy);
    vec4 far_point = camera.inverse_view_projection * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    far_point /= far_point.w;
    const vec3 origin = camera.camera_position.xyz;
    const HitPayload primary = Trace(origin, normalize(far_point.xyz - origin), 1000.0);
    if (camera.probe_mode == 1u)
        return primary.hit != 0u ? vec3(1.0) : vec3(0.0);
    if (camera.probe_mode == 2u)
        return primary.hit != 0u ? primary.normal * 0.5 + 0.5 : vec3(0.0);
    if (camera.probe_mode == 3u)
        return primary.hit != 0u ? primary.albedo : vec3(0.0);

    vec3 radiance = vec3(0.0);
    if (primary.hit != 0u)
    {
        if (primary.geometry == 0u)
        {
            radiance = camera.light_radiance.rgb;
        }
        else
        {
            radiance = DirectLight(primary, 0u, sample_index);
            if (camera.probe_mode != 4u)
            {
                const vec3 bounce_direction = CosineDirection(primary.normal, sample_index);
                const HitPayload secondary = Trace(primary.position + primary.normal * 0.002,
                                                   bounce_direction, 1000.0);
                if (secondary.hit != 0u && secondary.geometry != 0u)
                    radiance += primary.albedo * DirectLight(secondary, 1u, sample_index);
            }
        }
    }
    return radiance;
}

void main()
{
    const ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec3 radiance_sum = vec3(0.0);
    for (uint sample_index = 0u; sample_index < camera.samples_per_dispatch; ++sample_index)
        radiance_sum += TraceSample(sample_index);

    const uint next_sample_count = camera.sample_count + camera.samples_per_dispatch;
    if (camera.sample_count > 0u)
        radiance_sum = (imageLoad(history_image, pixel).rgb * float(camera.sample_count) +
                        radiance_sum) / float(next_sample_count);
    else
        radiance_sum /= float(camera.samples_per_dispatch);
    imageStore(output_image, pixel, vec4(radiance_sum, 1.0));
}
